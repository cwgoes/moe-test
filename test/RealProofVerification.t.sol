pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {MASPVerifier} from "../src/MASPVerifier.sol";
import {BLS12381} from "../src/BLS12381.sol";
import {Groth16Verifier} from "../src/Groth16Verifier.sol";

/// @title Real Groth16 Proof Verification Tests
/// @notice Tests verification of actual Groth16 proofs generated by the Rust prover
/// @dev These proofs are for a multiplication circuit: x * y = z
///      Generated using bellman with BLS12-381 curve
contract RealProofVerificationTest is Test {
    MASPVerifier public verifier;

    // ============ Verification Key from Rust Prover ============
    // Circuit: x * y = z (multiplication)
    // Generated with bellman on BLS12-381

    bytes constant VK_ALPHA = hex"0000000000000000000000000000000011510e82cee26d26da160f681fbdd253cd766dfe6350af5ef160f16b936a1635c6657f9042c0d026ed4946c0dd015ada000000000000000000000000000000001352adb9cd63363068985568e84d82ded28446647d941affb07fe087bdff22bbebbb3355db2555eb020ef12d6f2886f8";

    bytes constant VK_BETA = hex"";

    bytes constant VK_GAMMA = hex"";

    bytes constant VK_DELTA = hex"";

    // IC points (IC[0], IC[1] for 1 public input)
    bytes constant VK_IC_0 = hex"0000000000000000000000000000000006044ddc3a2b6dd3298a69daa53d182324a1c54a4df19ef8c25c13a7f7044f31d3b12756415d872ad608a130e5867e6e000000000000000000000000000000000da0acf7bf8abaa65eef89701359ec4c6ef5596ecab0afda0dd2de81b76e88537d046c1588d6c5a28e6eb47d73e47717";

    bytes constant VK_IC_1 = hex"0000000000000000000000000000000003b1f6f3da602b23e2d3cd37e257255f4a903245dc83c55182d3e5a7011c3b7e761e4b778ce56439be77512c756d2bcf000000000000000000000000000000000077e228573a8caa92844abfa19ab9a377045c1552ce258e573d2a3755840006dd0977e0a65f1390c4f97f16d5e2671b";

    // ============ Valid Proofs ============

    // Proof 1: 3 * 7 = 21 (0x15)
    bytes constant PROOF_1 = hex"";
    bytes32 constant PUBLIC_INPUT_1 = bytes32(uint256(21)); // 3 * 7 = 21

    // Proof 2: 2 * 5 = 10 (0x0a)
    bytes constant PROOF_2 = hex"";
    bytes32 constant PUBLIC_INPUT_2 = bytes32(uint256(10)); // 2 * 5 = 10

    // Proof 3: 4 * 6 = 24 (0x18)
    bytes constant PROOF_3 = hex"";
    bytes32 constant PUBLIC_INPUT_3 = bytes32(uint256(24)); // 4 * 6 = 24

    // Proof 4: 10 * 10 = 100 (0x64)
    bytes constant PROOF_4 = hex"";
    bytes32 constant PUBLIC_INPUT_4 = bytes32(uint256(100)); // 10 * 10 = 100

    // Proof 5: 1 * 1 = 1 (0x01)
    bytes constant PROOF_5 = hex"";
    bytes32 constant PUBLIC_INPUT_5 = bytes32(uint256(1)); // 1 * 1 = 1

    // ============ Invalid Proof ============
    // This proof was generated for 3 * 7 = 21, but we claim z = 22
    bytes constant INVALID_PROOF = hex"";
    bytes32 constant INVALID_PUBLIC_INPUT = bytes32(uint256(22)); // Wrong! Should be 21

    function setUp() public {
        verifier = new MASPVerifier();
        _setupVerificationKey();
    }

    /// @notice Set up the verification key for the multiplication circuit
    function _setupVerificationKey() internal {
        bytes[] memory ic = new bytes[](2);
        ic[0] = VK_IC_0;
        ic[1] = VK_IC_1;

        verifier.setVerificationKey(
            MASPVerifier.CircuitType.Spend, // Using Spend circuit type for testing
            VK_ALPHA,
            VK_BETA,
            VK_GAMMA,
            VK_DELTA,
            ic
        );
    }

    // ============ Valid Proof Tests ============

    /// @notice Test verification of proof 1: 3 * 7 = 21
    function test_RealProof_3x7_21() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = PUBLIC_INPUT_1;

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_1,
            publicInputs
        );

        assertTrue(valid, "Proof for 3 * 7 = 21 should verify");
    }

    /// @notice Test verification of proof 2: 2 * 5 = 10
    function test_RealProof_2x5_10() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = PUBLIC_INPUT_2;

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_2,
            publicInputs
        );

        assertTrue(valid, "Proof for 2 * 5 = 10 should verify");
    }

    /// @notice Test verification of proof 3: 4 * 6 = 24
    function test_RealProof_4x6_24() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = PUBLIC_INPUT_3;

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_3,
            publicInputs
        );

        assertTrue(valid, "Proof for 4 * 6 = 24 should verify");
    }

    /// @notice Test verification of proof 4: 10 * 10 = 100
    function test_RealProof_10x10_100() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = PUBLIC_INPUT_4;

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_4,
            publicInputs
        );

        assertTrue(valid, "Proof for 10 * 10 = 100 should verify");
    }

    /// @notice Test verification of proof 5: 1 * 1 = 1
    function test_RealProof_1x1_1() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = PUBLIC_INPUT_5;

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_5,
            publicInputs
        );

        assertTrue(valid, "Proof for 1 * 1 = 1 should verify");
    }

    // ============ Invalid Proof Tests ============

    /// @notice Test that invalid proof (wrong public input) fails verification
    function test_InvalidProof_WrongPublicInput() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = INVALID_PUBLIC_INPUT; // 22 instead of 21

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            INVALID_PROOF,
            publicInputs
        );

        assertFalse(valid, "Proof with wrong public input should fail verification");
    }

    /// @notice Test that valid proof with wrong public input fails
    function test_ValidProof_WrongPublicInput() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = bytes32(uint256(20)); // Wrong value (should be 21)

        bool valid = verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_1,
            publicInputs
        );

        assertFalse(valid, "Proof with mismatched public input should fail");
    }

    // ============ Batch Verification Tests ============

    /// @notice Test batch verification of all 5 valid proofs
    function test_BatchVerify_AllValidProofs() public view {
        MASPVerifier.CircuitType[] memory types = new MASPVerifier.CircuitType[](5);
        bytes[] memory proofs = new bytes[](5);
        bytes32[][] memory publicInputs = new bytes32[][](5);

        for (uint256 i = 0; i < 5; i++) {
            types[i] = MASPVerifier.CircuitType.Spend;
            publicInputs[i] = new bytes32[](1);
        }

        proofs[0] = PROOF_1;
        publicInputs[0][0] = PUBLIC_INPUT_1;
        proofs[1] = PROOF_2;
        publicInputs[1][0] = PUBLIC_INPUT_2;
        proofs[2] = PROOF_3;
        publicInputs[2][0] = PUBLIC_INPUT_3;
        proofs[3] = PROOF_4;
        publicInputs[3][0] = PUBLIC_INPUT_4;
        proofs[4] = PROOF_5;
        publicInputs[4][0] = PUBLIC_INPUT_5;

        bool valid = verifier.batchVerifyProofs(types, proofs, publicInputs);
        assertTrue(valid, "Batch verification of all valid proofs should pass");
    }

    /// @notice Test batch verification fails with one invalid proof
    function test_BatchVerify_OneInvalidProof() public view {
        MASPVerifier.CircuitType[] memory types = new MASPVerifier.CircuitType[](3);
        bytes[] memory proofs = new bytes[](3);
        bytes32[][] memory publicInputs = new bytes32[][](3);

        for (uint256 i = 0; i < 3; i++) {
            types[i] = MASPVerifier.CircuitType.Spend;
            publicInputs[i] = new bytes32[](1);
        }

        proofs[0] = PROOF_1;
        publicInputs[0][0] = PUBLIC_INPUT_1;
        proofs[1] = INVALID_PROOF;
        publicInputs[1][0] = INVALID_PUBLIC_INPUT; // Invalid
        proofs[2] = PROOF_3;
        publicInputs[2][0] = PUBLIC_INPUT_3;

        bool valid = verifier.batchVerifyProofs(types, proofs, publicInputs);
        assertFalse(valid, "Batch verification with invalid proof should fail");
    }

    // ============ Gas Benchmarks ============

    /// @notice Measure gas for single proof verification
    function test_GasBenchmark_SingleProof() public {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = PUBLIC_INPUT_1;

        uint256 gasBefore = gasleft();
        verifier.verifyProof(MASPVerifier.CircuitType.Spend, PROOF_1, publicInputs);
        uint256 gasUsed = gasBefore - gasleft();

        emit log_named_uint("Gas used for single real proof verification", gasUsed);
    }

    /// @notice Measure gas for batch proof verification
    function test_GasBenchmark_BatchProofs() public {
        MASPVerifier.CircuitType[] memory types = new MASPVerifier.CircuitType[](5);
        bytes[] memory proofs = new bytes[](5);
        bytes32[][] memory publicInputs = new bytes32[][](5);

        for (uint256 i = 0; i < 5; i++) {
            types[i] = MASPVerifier.CircuitType.Spend;
            publicInputs[i] = new bytes32[](1);
        }

        proofs[0] = PROOF_1;
        publicInputs[0][0] = PUBLIC_INPUT_1;
        proofs[1] = PROOF_2;
        publicInputs[1][0] = PUBLIC_INPUT_2;
        proofs[2] = PROOF_3;
        publicInputs[2][0] = PUBLIC_INPUT_3;
        proofs[3] = PROOF_4;
        publicInputs[3][0] = PUBLIC_INPUT_4;
        proofs[4] = PROOF_5;
        publicInputs[4][0] = PUBLIC_INPUT_5;

        uint256 gasBefore = gasleft();
        verifier.batchVerifyProofs(types, proofs, publicInputs);
        uint256 gasUsed = gasBefore - gasleft();

        emit log_named_uint("Gas used for batch of 5 real proof verifications", gasUsed);
    }
}
