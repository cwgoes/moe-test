        MASPVerifier.CircuitType[] memory types = new MASPVerifier.CircuitType[](2);
        bytes[] memory proofs = new bytes[](2);
        bytes32[][] memory publicInputsArray = new bytes32[][](2);

        // Shield operation
        types[0] = MASPVerifier.CircuitType.Output;
        proofs[0] = PROOF_SHIELD_100_NAM;
        publicInputsArray[0] = new bytes32[](3);
        publicInputsArray[0][0] = INPUT_SHIELD_100_NAM_0;
        publicInputsArray[0][1] = INPUT_SHIELD_100_NAM_1;
        publicInputsArray[0][2] = INPUT_SHIELD_100_NAM_2;

        // Unshield operation
        types[1] = MASPVerifier.CircuitType.Spend;
        proofs[1] = PROOF_UNSHIELD_100_NAM;
        publicInputsArray[1] = new bytes32[](4);
        publicInputsArray[1][0] = INPUT_UNSHIELD_100_NAM_0;
        publicInputsArray[1][1] = INPUT_UNSHIELD_100_NAM_1;
        publicInputsArray[1][2] = INPUT_UNSHIELD_100_NAM_2;
        publicInputsArray[1][3] = INPUT_UNSHIELD_100_NAM_3;

        bool allValid = verifier.batchVerifyProofs(types, proofs, publicInputsArray);
        assertTrue(allValid, "Batch shield/unshield should verify");
    }

    // ============= VK SETUP TESTS (no precompiles needed) =============

    function test_SpendVKSetup() public {
        _setupSpendVK();
        assertTrue(verifier.isInitialized(MASPVerifier.CircuitType.Spend));
        assertEq(verifier.getPublicInputsCount(MASPVerifier.CircuitType.Spend), 4);
    }

    function test_OutputVKSetup() public {
        _setupOutputVK();
        assertTrue(verifier.isInitialized(MASPVerifier.CircuitType.Output));
        assertEq(verifier.getPublicInputsCount(MASPVerifier.CircuitType.Output), 3);
    }

    function test_ConvertVKSetup() public {
        _setupConvertVK();
        assertTrue(verifier.isInitialized(MASPVerifier.CircuitType.Convert));
        assertEq(verifier.getPublicInputsCount(MASPVerifier.CircuitType.Convert), 2);
    }

    function test_ProofDataSizes() public pure {
        // All proofs should be 512 bytes
        assertEq(PROOF_SHIELD_100_NAM.length, 512);
        assertEq(PROOF_UNSHIELD_100_NAM.length, 512);
        assertEq(PROOF_CONVERT_NAM_TO_ETH_1X2.length, 512);
    }
