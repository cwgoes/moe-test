        try verifier.verifyProof(
            MASPVerifier.CircuitType.Spend,
            PROOF_UNSHIELD_100_NAM,
            publicInputs
        ) returns (bool result) {
            // If we get here without reverting, precompiles are working
            // The result should be true for a valid proof
            return result;
        } catch {
            // Precompile call failed
            return false;
        }
    }

